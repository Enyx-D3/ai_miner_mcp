# AI Miner authoritative web/runtime
AI_MINER_BASE_URL=http://127.0.0.1:3000
AI_MINER_TIMEOUT_MS=15000

# Optional if your AI Miner API is protected for server-to-server reads.
# Set ONE of these only if needed.
AI_MINER_BEARER_TOKEN=
AI_MINER_COOKIE=

# Brain2 ChatGPT MCP endpoint
MCP_BIND=127.0.0.1
MCP_PORT=8787
MCP_PATH=/mcp

# For local + Secure MCP Tunnel testing leave none.
# For a generic remote deployment you can require a bearer token.
MCP_AUTH_MODE=none
MCP_SHARED_SECRET=

# Durable execution state ONLY. This is not the AI Miner source of truth.
BRAIN2_MISSION_DATA_DIR=./data

# Hard deterministic bounds
BRAIN2_MAX_TERMS=80
BRAIN2_MAX_QUERIES=600
BRAIN2_DEFAULT_BATCH=8
